<Window x:Class="DroneRebuild.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:h="http://helix-toolkit.org/wpf" Title="DroneRebuild · Roll / Pitch" Width="1320" Height="900" MinWidth="1040" MinHeight="740" Background="#F3F5F9" FontFamily="Segoe UI" FontSize="13" Closing="ClosingWindow">
 <Window.Resources>
  <Style TargetType="TextBlock"><Setter Property="Foreground" Value="#17243B"/><Setter Property="VerticalAlignment" Value="Center"/></Style>
  <Style x:Key="Label" TargetType="TextBlock"><Setter Property="Foreground" Value="#66758A"/><Setter Property="FontSize" Value="12"/><Setter Property="Margin" Value="0,0,0,5"/></Style>
  <Style TargetType="TextBox"><Setter Property="Padding" Value="9,7"/><Setter Property="BorderBrush" Value="#D9E0EB"/><Setter Property="Background" Value="#FAFBFD"/><Setter Property="Foreground" Value="#17243B"/><Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="MinHeight" Value="34"/></Style>
  <Style TargetType="ComboBox"><Setter Property="Padding" Value="8,6"/><Setter Property="MinHeight" Value="34"/><Setter Property="VerticalContentAlignment" Value="Center"/></Style>
  <Style TargetType="Button">
   <Setter Property="Padding" Value="12,8"/><Setter Property="MinHeight" Value="36"/><Setter Property="Background" Value="White"/><Setter Property="Foreground" Value="#17243B"/><Setter Property="BorderBrush" Value="#D9E0EB"/><Setter Property="Cursor" Value="Hand"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Surface" CornerRadius="6" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Opacity" Value="0.82"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="Surface" Property="Opacity" Value="0.4"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="#2563EB"/><Setter TargetName="Surface" Property="BorderThickness" Value="2"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="Primary" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Background" Value="#245DE8"/><Setter Property="BorderBrush" Value="#245DE8"/><Setter Property="Foreground" Value="White"/><Setter Property="FontWeight" Value="SemiBold"/></Style>
  <Style x:Key="Card" TargetType="Border"><Setter Property="Background" Value="White"/><Setter Property="BorderBrush" Value="#E2E7F0"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="10"/><Setter Property="Padding" Value="16"/></Style>
  <Style TargetType="CheckBox"><Setter Property="Margin" Value="0,8,0,5"/><Setter Property="Foreground" Value="#17243B"/></Style>
  <Style TargetType="TabItem"><Setter Property="Padding" Value="10,6"/></Style>
 </Window.Resources>
 <Grid Margin="14"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Grid Margin="0,0,0,10"><Grid.ColumnDefinitions><ColumnDefinition Width="190"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <StackPanel><TextBlock Text="DroneRebuild" FontSize="24" FontWeight="SemiBold"/><TextBlock Text="Kiểm chứng Roll / Pitch · từng trục trên đế" TextWrapping="Wrap" FontSize="11" Foreground="#66758A" Margin="0,3,0,0"/></StackPanel>
    <UniformGrid Grid.Column="1" Columns="4" Margin="16,0,16,0">
     <Border Style="{StaticResource Card}" Padding="10,5" Margin="0,0,8,0"><StackPanel><TextBlock Text="GÓC ROLL" Style="{StaticResource Label}"/><TextBlock x:Name="RollValue" Text="—" FontSize="20" FontWeight="SemiBold"/><TextBlock Text="Độ · theo cảm biến" Foreground="#66758A" FontSize="10" TextWrapping="Wrap"/></StackPanel></Border>
     <Border Style="{StaticResource Card}" Padding="10,5" Margin="0,0,8,0"><StackPanel><TextBlock Text="GÓC PITCH" Style="{StaticResource Label}"/><TextBlock x:Name="PitchValue" Text="—" FontSize="20" FontWeight="SemiBold"/><TextBlock Text="Độ · theo cảm biến" Foreground="#66758A" FontSize="10" TextWrapping="Wrap"/></StackPanel></Border>
     <Border Style="{StaticResource Card}" Padding="10,5" Margin="0,0,8,0"><StackPanel><TextBlock x:Name="RateTitle" Text="TỐC ĐỘ ROLL" Style="{StaticResource Label}"/><TextBlock x:Name="RateValue" Text="—" FontSize="20" FontWeight="SemiBold"/><TextBlock x:Name="RateTargetValue" Text="Mục tiêu: — °/s" Foreground="#66758A" FontSize="10" TextWrapping="Wrap"/></StackPanel></Border>
     <Border Style="{StaticResource Card}" Padding="10,5"><StackPanel><TextBlock Text="OUTPUT PID" Style="{StaticResource Label}"/><TextBlock x:Name="OutputValue" Text="—" FontSize="20" FontWeight="SemiBold"/><TextBlock x:Name="LimitValue" Text="Chưa có dữ liệu" Foreground="#66758A" FontSize="10" TextWrapping="Wrap"/></StackPanel></Border>
    </UniformGrid>
   <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center"><Border Background="#E8EDF5" CornerRadius="16" Padding="12,6" Margin="0,0,14,0"><TextBlock x:Name="ConnectionBadge" Text="CHƯA KẾT NỐI" FontSize="11" FontWeight="SemiBold"/></Border><Button Content="■  DỪNG MOTOR   ·   Esc" Background="#B42332" BorderBrush="#B42332" Foreground="White" FontWeight="SemiBold" MinHeight="44" Click="StopClick"/></StackPanel>
  </Grid>
  <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="340"/><ColumnDefinition Width="18"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
   <Grid><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,4,0"><StackPanel>
    <Border Style="{StaticResource Card}"><StackPanel>
     <TextBlock Text="1   Kết nối thiết bị" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,12"/>
     <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="100"/><ColumnDefinition Width="10"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><ComboBox x:Name="Transport" SelectedIndex="0" SelectionChanged="TransportChanged"><ComboBoxItem Content="USB"/><ComboBoxItem Content="Wi-Fi / TCP"/></ComboBox><TextBox x:Name="Address" Grid.Column="2" Text="COM6" ToolTip="USB: cổng COM. Wi-Fi: địa chỉ IP của ESP32."/></Grid>
     <TextBlock x:Name="ConnectionHint" Text="USB · 460800 baud" Style="{StaticResource Label}" Margin="0,6,0,10"/>
     <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="8"/><ColumnDefinition/></Grid.ColumnDefinitions><Button x:Name="ConnectButton" Content="Kết nối" Style="{StaticResource Primary}" Click="ConnectClick"/><Button x:Name="DisconnectButton" Grid.Column="2" Content="Ngắt kết nối" Click="DisconnectClick"/></Grid>
     <Grid Margin="0,8,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="8"/><ColumnDefinition/></Grid.ColumnDefinitions><Button Content="Thông tin board" Click="InfoClick"/><Button Grid.Column="2" Content="Hiệu chuẩn IMU" Click="CalibrateClick"/></Grid>
     <Button x:Name="ZeroRollButton" Content="Khung đang ngang · Lấy mốc 0°" Click="ZeroRollClick" Margin="0,8,0,0" ToolTip="Đặt khung ngang thật và đứng yên ít nhất 1 giây. Mốc chỉ dùng đến khi reset hoặc hiệu chuẩn IMU lại."/>
     <TextBlock Text="Lấy mốc khi motor đã dừng, khung ngang và đứng yên." Foreground="SlateGray" TextWrapping="Wrap" Margin="0,6,0,0"/>
    </StackPanel></Border>
    <Border Style="{StaticResource Card}" Margin="0,12,0,0"><StackPanel>
     <TextBlock Text="2   Chuẩn bị lượt thử" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,12"/>
     <TabControl x:Name="TestTabs" BorderThickness="0" Background="White" SelectionChanged="TestTabChanged">
      <TabItem Header="Điều khiển trục"><StackPanel Margin="0,12,0,0">
       <TextBlock Text="Trục thử · mỗi lượt một trục" Style="{StaticResource Label}"/><ComboBox x:Name="AxisChoice" SelectedIndex="0" SelectionChanged="AxisChanged"><ComboBoxItem Content="Roll · nghiêng trái / phải"/><ComboBoxItem Content="Pitch · chúi / ngẩng đầu"/></ComboBox>
       <TextBlock Text="Chế độ chạy" Style="{StaticResource Label}" Margin="0,10,0,5"/><ComboBox x:Name="Mode" SelectedIndex="0" SelectionChanged="ModeChanged"><ComboBoxItem Content="Inner · tốc độ (RATE)"/><ComboBoxItem Content="Outer + Inner · góc (ANGLE)"/><ComboBoxItem Content="Tính thử · không xuất motor"/></ComboBox>
       <TextBlock Text="Inner PID · tốc độ → duty" FontWeight="SemiBold" Margin="0,14,0,8"/>
       <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="8"/><ColumnDefinition/><ColumnDefinition Width="8"/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Kp" Style="{StaticResource Label}"/><TextBox x:Name="Kp" Text="0"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="Ki" Style="{StaticResource Label}"/><TextBox x:Name="Ki" Text="0"/></StackPanel><StackPanel Grid.Column="4"><TextBlock Text="Kd" Style="{StaticResource Label}"/><TextBox x:Name="Kd" Text="0"/></StackPanel></Grid>
       <TextBlock Text="Outer PID · góc → tốc độ" FontWeight="SemiBold" Margin="0,12,0,8"/>
       <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="8"/><ColumnDefinition/><ColumnDefinition Width="8"/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Kp" Style="{StaticResource Label}"/><TextBox x:Name="AngleKp" Text="0"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="Ki" Style="{StaticResource Label}"/><TextBox x:Name="AngleKi" Text="0"/></StackPanel><StackPanel Grid.Column="4"><TextBlock Text="Kd" Style="{StaticResource Label}"/><TextBox x:Name="AngleKd" Text="0"/></StackPanel></Grid>
       <TextBlock Text="RATE dùng Inner; ANGLE dùng cả Outer và Inner. Gain riêng cho từng trục Roll/Pitch." Foreground="#66758A" FontSize="11" TextWrapping="Wrap" Margin="0,6,0,8"/>
       <TextBlock Text="Duty nền · Base" Style="{StaticResource Label}"/><TextBox x:Name="BaseDuty" Text="80"/>
       <Expander Header="Chiều motor và giới hạn" Margin="0,12,0,10"><Grid Margin="0,10,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="8"/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Motor sign · ±1" Style="{StaticResource Label}"/><TextBox x:Name="Sign" Text="1"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="Output limit · duty" Style="{StaticResource Label}"/><TextBox x:Name="Limit" Text="20"/></StackPanel></Grid></Expander>
       <Button x:Name="ApplyButton" Content="Áp dụng cấu hình lên board" Click="ApplyClick"/><TextBlock x:Name="AcceptedSummary" Text="Chưa nhận cấu hình từ board." Style="{StaticResource Label}" TextWrapping="Wrap" Margin="0,6,0,12"/>
       <StackPanel><TextBlock x:Name="TargetLabel" Text="Mục tiêu · °/s" Style="{StaticResource Label}"/><TextBox x:Name="Target" Text="0"/><TextBlock Text="Chạy liên tục đến khi STOP hoặc có lỗi. Không tự dừng theo góc hay tốc độ quay." Style="{StaticResource Label}" TextWrapping="Wrap" Margin="0,6,0,0"/></StackPanel>
       <CheckBox x:Name="Verified" Unchecked="ConfirmationRemoved"><TextBlock Text="Đã kiểm tra trục IMU, chiều lực motor, đế đúng trục đang chọn và mốc ngang." TextWrapping="Wrap"/></CheckBox>
      </StackPanel></TabItem>
      <TabItem Header="Thử từng motor"><StackPanel Margin="0,12,0,0">
       <Border Background="#FFF4DF" CornerRadius="6" Padding="10"><TextBlock Text="Chỉ thử khi đã tháo cánh. Mỗi lượt chạy 1 giây." TextWrapping="Wrap" Foreground="#815818"/></Border>
       <TextBlock Text="Motor cần thử" Style="{StaticResource Label}" Margin="0,14,0,5"/><ComboBox x:Name="Motor" SelectedIndex="0"><ComboBoxItem Content="LF · Trước trái"/><ComboBoxItem Content="RF · Trước phải"/><ComboBoxItem Content="LR · Sau trái"/><ComboBoxItem Content="RR · Sau phải"/></ComboBox>
       <TextBlock Text="Duty · từ 0 đến 89" Style="{StaticResource Label}" Margin="0,12,0,5"/><TextBox x:Name="BenchDuty" Text="20"/>
       <CheckBox x:Name="PropsRemoved" Unchecked="ConfirmationRemoved"><TextBlock Text="Đã tháo toàn bộ cánh quạt." TextWrapping="Wrap"/></CheckBox>
       <TextBlock Text="ARM trước, rồi bấm Chạy motor ở khung bên dưới. Mỗi lượt cần ARM mới." TextWrapping="Wrap" Foreground="#66758A" Margin="0,10,0,8"/>
      </StackPanel></TabItem>
     </TabControl>
    </StackPanel></Border>
    <Border Style="{StaticResource Card}" Margin="0,12,0,0"><StackPanel><TextBlock Text="Lưu dữ liệu" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,10"/><TextBlock Text="Đế, nguồn/pin, cánh, góc đầu" Style="{StaticResource Label}"/><TextBox x:Name="SessionNote" Text="Chưa ghi: đế, nguồn/pin, cánh, góc đầu" TextWrapping="Wrap" AcceptsReturn="True" MinHeight="56"/><Button x:Name="LogButton" Content="Bắt đầu ghi log" Click="LogClick" Margin="0,10,0,8"/><Button Content="Mở CSV mô phỏng…" Click="ReplayClick"/></StackPanel></Border>
   </StackPanel></ScrollViewer>
   <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,10,4,0" Padding="14"><StackPanel>
    <TextBlock Text="3   Cho phép và bắt đầu" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,10"/>
    <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="8"/><ColumnDefinition/></Grid.ColumnDefinitions><Button x:Name="ArmButton" Content="1. ARM" Click="ArmClick"/><Button x:Name="StartButton" Grid.Column="2" Content="2. Bắt đầu Roll" Style="{StaticResource Primary}" Click="StartClick"/><Button x:Name="BenchButton" Grid.Column="2" Content="2. Chạy motor" ToolTip="Chạy motor đã chọn trong 1 giây." Visibility="Collapsed" Style="{StaticResource Primary}" Click="BenchClick"/></Grid>
    <TextBlock x:Name="RunHint" Text="Kết nối và đợi cảm biến sẵn sàng." Foreground="#66758A" FontSize="12" TextWrapping="Wrap" Margin="0,8,0,0"/>
   </StackPanel></Border></Grid>
   <Grid Grid.Column="2"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <Border Style="{StaticResource Card}" Padding="12,6"><TextBlock x:Name="Status" Text="Chưa kết nối · chưa có dữ liệu từ board" TextWrapping="Wrap"/></Border>

    <TabControl Grid.Row="1" Margin="0,6,0,0" x:Name="ViewTabs" Background="White"><TabItem Header="Đồ thị PID"><DockPanel><WrapPanel DockPanel.Dock="Top" Margin="6,4"><Button Content="−" Click="PlotZoomOutClick" ToolTip="Thu nhỏ trục thời gian" Margin="0,0,5,0"/><Button Content="+" Click="PlotZoomInClick" ToolTip="Phóng to trục thời gian" Margin="0,0,8,0"/><Button Content="Theo dõi mới nhất" Click="PlotFollowClick" Margin="0,0,10,0"/><TextBlock x:Name="PlotViewStatus" Text="Cuộn: zoom thời gian · Ctrl+cuộn: zoom giá trị · kéo: xem lại" TextTrimming="CharacterEllipsis" FontSize="11" Foreground="#66758A" ToolTip="Cuộn: zoom thời gian · Ctrl+cuộn: zoom giá trị · kéo: di chuyển · bấm đúp: đặt lại"/></WrapPanel><Grid Margin="4,0,4,4"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="8"/><ColumnDefinition/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition/><RowDefinition Height="8"/><RowDefinition/></Grid.RowDefinitions>
     <Border Style="{StaticResource Card}" Padding="8,5"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><StackPanel Orientation="Horizontal"><TextBlock Text="Góc Roll / Pitch · °" FontWeight="SemiBold"/><TextBlock x:Name="AngleLegend" Text="Xanh: Roll · Xanh lá: Pitch" Foreground="#66758A" FontSize="11" Margin="12,0,0,0" TextWrapping="Wrap"/></StackPanel><Canvas Grid.Row="1" x:Name="AnglePlot" MouseWheel="PlotWheel" MouseLeftButtonDown="PlotMouseDown" MouseMove="PlotMouseMove" MouseLeftButtonUp="PlotMouseUp" LostMouseCapture="PlotLostCapture" Cursor="Hand" Background="White" ClipToBounds="True" SizeChanged="PlotResize"/></Grid></Border>
     <Border Grid.Column="2" Style="{StaticResource Card}" Padding="8,5"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><StackPanel Orientation="Horizontal"><TextBlock x:Name="RatePlotTitle" Text="Tốc độ Roll · °/s" FontWeight="SemiBold"/><TextBlock Text="Xanh: đo · Cam: mục tiêu" Foreground="#66758A" FontSize="11" Margin="12,0,0,0"/></StackPanel><Canvas Grid.Row="1" x:Name="RatePlot" MouseWheel="PlotWheel" MouseLeftButtonDown="PlotMouseDown" MouseMove="PlotMouseMove" MouseLeftButtonUp="PlotMouseUp" LostMouseCapture="PlotLostCapture" Cursor="Hand" Background="White" ClipToBounds="True" SizeChanged="PlotResize"/></Grid></Border>
     <Border Grid.Row="2" Style="{StaticResource Card}" Padding="8,5"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><StackPanel Orientation="Horizontal"><TextBlock Text="Phần sửa PID · duty" FontWeight="SemiBold"/><TextBlock Text="Tím: output sau giới hạn" Foreground="#66758A" FontSize="11" Margin="12,0,0,0"/></StackPanel><Canvas Grid.Row="1" x:Name="OutputPlot" MouseWheel="PlotWheel" MouseLeftButtonDown="PlotMouseDown" MouseMove="PlotMouseMove" MouseLeftButtonUp="PlotMouseUp" LostMouseCapture="PlotLostCapture" Cursor="Hand" Background="White" ClipToBounds="True" SizeChanged="PlotResize"/></Grid></Border>
     <Border Grid.Row="2" Grid.Column="2" Style="{StaticResource Card}" Padding="8,5"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><StackPanel Orientation="Horizontal"><TextBlock Text="Lệnh motor · duty" FontWeight="SemiBold"/><TextBlock Text="Xanh lá: LF/LR · Xám: RF/RR" Foreground="#66758A" FontSize="11" Margin="12,0,0,0"/></StackPanel><Canvas Grid.Row="1" x:Name="MotorPlot" MouseWheel="PlotWheel" MouseLeftButtonDown="PlotMouseDown" MouseMove="PlotMouseMove" MouseLeftButtonUp="PlotMouseUp" LostMouseCapture="PlotLostCapture" Cursor="Hand" Background="White" ClipToBounds="True" SizeChanged="PlotResize"/></Grid></Border>
    </Grid></DockPanel>
    </TabItem>
    <TabItem Header="3D IMU"><Grid Margin="8"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
     <Grid Margin="0,0,0,10"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock x:Name="OrientationReadout" Text="Roll — · Pitch — · Yaw —" FontWeight="SemiBold"/><TextBlock x:Name="OrientationStatus" Text="Chờ góc IMU từ firmware mới." Foreground="#66758A" TextWrapping="Wrap" Margin="0,4,10,0"/><TextBlock Text="Roll/Pitch theo IMU · Yaw tương đối, có thể trôi theo thời gian." Foreground="#66758A" FontSize="11" Margin="0,4,10,0" TextWrapping="Wrap"/></StackPanel><Button Grid.Column="1" x:Name="ZeroYawButton" Content="Hiệu chỉnh yaw" Click="ZeroYawClick" IsEnabled="False" ToolTip="Đặt yaw hiện tại về 0°. Giữ nguyên roll và pitch đo bởi IMU."/></Grid>
     <Grid Grid.Row="1">
      <h:HelixViewport3D Background="#E6EBF1" ModelUpDirection="0,1,0" ShowViewCube="True" ShowCoordinateSystem="False" ZoomExtentsWhenLoaded="False" IsHeadLightEnabled="False">
       <h:HelixViewport3D.Camera><PerspectiveCamera Position="0,7,15" LookDirection="0,-7,-15" UpDirection="0,1,0" FieldOfView="42"/></h:HelixViewport3D.Camera>
       <ModelVisual3D><ModelVisual3D.Content><Model3DGroup>
        <AmbientLight Color="#747A82"/>
        <DirectionalLight Color="#E8E2D8" Direction="-3,-5,-4"/>
        <DirectionalLight Color="#8B9DB3" Direction="4,-2,-1"/>
        <DirectionalLight Color="#9CAABC" Direction="0,-1,4"/>
       </Model3DGroup></ModelVisual3D.Content></ModelVisual3D>
       <h:GridLinesVisual3D Width="12" Length="12" MinorDistance="0.5" MajorDistance="2" Thickness="0.008" Fill="#D4DCE6"><h:GridLinesVisual3D.Transform><Transform3DGroup><RotateTransform3D><RotateTransform3D.Rotation><AxisAngleRotation3D Axis="1,0,0" Angle="-90"/></RotateTransform3D.Rotation></RotateTransform3D><TranslateTransform3D OffsetY="-1.2"/></Transform3DGroup></h:GridLinesVisual3D.Transform></h:GridLinesVisual3D>
       <h:CoordinateSystemVisual3D ArrowLengths="1.2"/>
       <ModelVisual3D x:Name="DroneModel"><ModelVisual3D.Transform><RotateTransform3D><RotateTransform3D.Rotation><QuaternionRotation3D x:Name="DroneRotation"/></RotateTransform3D.Rotation></RotateTransform3D></ModelVisual3D.Transform></ModelVisual3D>
      </h:HelixViewport3D>
      <TextBlock x:Name="ModelLoadStatus" Text="Đang tải mô hình drone…" Foreground="#66758A" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="16" TextWrapping="Wrap" IsHitTestVisible="False"/>
     </Grid>
    </Grid></TabItem>
    <TabItem Header="Chi tiết và nhật ký"><TabControl BorderThickness="0" Margin="8"><TabItem Header="Số đo / cấu hình đã nhận"><ScrollViewer VerticalScrollBarVisibility="Auto"><TextBlock x:Name="Readout" VerticalAlignment="Top" Text="Chưa có dữ liệu đo từ board." FontFamily="Consolas" FontSize="12" TextWrapping="Wrap" Margin="8"/></ScrollViewer></TabItem><TabItem Header="Nhật ký sự kiện"><TextBox x:Name="Events" IsReadOnly="True" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="12"/></TabItem></TabControl></TabItem></TabControl>

   </Grid>
  </Grid>
  <TextBlock Grid.Row="2" Text="Mỗi lượt thử một trục trên đế · Gain mô phỏng là tham chiếu · Phím Esc gửi STOP" FontSize="11" Foreground="#66758A" Margin="0,6,0,0"/>
 </Grid>
</Window>
