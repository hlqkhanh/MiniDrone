<Window x:Class="DroneMotion.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:h="http://helix-toolkit.org/wpf"
        xmlns:controls="clr-namespace:DroneMotion.Wpf.Controls"
        mc:Ignorable="d"
        Title="Drone Motion Viewer"
        Width="1180" Height="720" MinWidth="900" MinHeight="580"
        Background="#0B1120" Foreground="#E2E8F0"
        Closed="Window_OnClosed">
    <Window.InputBindings>
        <KeyBinding Key="Escape" Command="{Binding StopMotorsCommand}"/>
    </Window.InputBindings>
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="Margin" Value="0,0,8,8"/>
            <Setter Property="Background" Value="#1E293B"/>
            <Setter Property="Foreground" Value="#F8FAFC"/>
            <Setter Property="BorderBrush" Value="#475569"/>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="Margin" Value="0,4,0,12"/>
        </Style>
        <Style x:Key="MetricValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="25"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#67E8F9"/>
            <Setter Property="Margin" Value="0,2,0,12"/>
        </Style>
    </Window.Resources>

    <Grid Margin="18">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="280"/>
            <ColumnDefinition Width="18"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="#111827" CornerRadius="12" Padding="18">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="DRONE IMU" FontSize="25" FontWeight="Bold"/>
                    <TextBlock Text="3D motion viewer" Foreground="#94A3B8" Margin="0,2,0,20"/>

                    <StackPanel IsEnabled="{Binding CanEditConnection}">
                    <CheckBox Content="Wi-Fi" IsChecked="{Binding UseWifi}" Foreground="#E2E8F0" Margin="0,0,0,10"/>
                    <StackPanel Visibility="{Binding UseWifi, Converter={StaticResource BoolToVisibility}}">
                        <ComboBox ItemsSource="{Binding WifiModes}" SelectedItem="{Binding WifiMode}"/>
                        <TextBlock Text="{Binding WifiInstructions}" Foreground="#67E8F9" TextWrapping="Wrap"/>
                        <TextBlock Text="ESP32 IP ADDRESS" FontSize="11" Foreground="#94A3B8" Margin="0,8,0,3"/>
                        <TextBox Text="{Binding WifiHost, UpdateSourceTrigger=PropertyChanged}" Padding="8,6"/>
                        <TextBlock Text="PORT" FontSize="11" Foreground="#94A3B8" Margin="0,8,0,3"/>
                        <TextBox Text="{Binding WifiPort, UpdateSourceTrigger=PropertyChanged}" Padding="8,6" Margin="0,0,0,12"/>
                    </StackPanel>
                    <StackPanel>
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding UseWifi}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                    <TextBlock Text="COM PORT" FontSize="11" Foreground="#94A3B8"/>
                    <ComboBox ItemsSource="{Binding AvailablePorts}"
                              SelectedItem="{Binding SelectedPort}"/>
                    <TextBlock Text="BAUD RATE" FontSize="11" Foreground="#94A3B8"/>
                    <ComboBox ItemsSource="{Binding BaudRates}"
                              SelectedItem="{Binding SelectedBaudRate}"/>
                    <Button Content="Refresh COM ports" Command="{Binding RefreshPortsCommand}"/>
                    </StackPanel>
                    </StackPanel>

                    <WrapPanel Margin="0,2,0,8">
                        <Button Content="Connect" Command="{Binding ConnectCommand}"/>
                        <Button Content="Disconnect" Command="{Binding DisconnectCommand}"/>
                    </WrapPanel>
                    <WrapPanel Margin="0,0,0,10">
                        <Button Content="Calibrate" Command="{Binding CalibrateCommand}"/>
                        <Button Content="Zero orientation" Command="{Binding ZeroCommand}"/>
                        <Button Content="STOP ALL (Esc)" Command="{Binding StopMotorsCommand}" Background="#991B1B"/>
                    </WrapPanel>

                    <Border Background="#0F172A" CornerRadius="7" Padding="10" Margin="0,0,0,18">
                        <StackPanel>
                            <TextBlock Text="{Binding ConnectionStatus}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                            <TextBlock Text="{Binding DeviceStatus}" Foreground="#94A3B8" Margin="0,4,0,0" TextWrapping="Wrap"/>
                            <TextBlock Text="{Binding TelemetryStatus}" Foreground="#67E8F9" TextWrapping="Wrap" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/>
                            <ColumnDefinition/>
                            <ColumnDefinition/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="ROLL" FontSize="10" Foreground="#94A3B8"/>
                            <TextBlock Style="{StaticResource MetricValue}" Text="{Binding Roll, StringFormat={}{0:F1}°}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="PITCH" FontSize="10" Foreground="#94A3B8"/>
                            <TextBlock Style="{StaticResource MetricValue}" Text="{Binding Pitch, StringFormat={}{0:F1}°}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="YAW" FontSize="10" Foreground="#94A3B8"/>
                            <TextBlock Style="{StaticResource MetricValue}" Text="{Binding Yaw, StringFormat={}{0:F1}°}"/>
                        </StackPanel>
                    </Grid>

                    <Border Background="#172033" CornerRadius="7" Padding="10" Margin="0,4,0,16">
                        <StackPanel>
                            <TextBlock Text="MANUAL MOTOR OUTPUT" FontWeight="Bold"/>
                            <TextBlock Text="Remove all propellers. Manual PWM has no flight stabilization."
                                       Foreground="#FBBF24" TextWrapping="Wrap" Margin="0,6,0,8"/>
                            <CheckBox Content="All propellers are removed" IsChecked="{Binding PropellersRemoved}"
                                      Foreground="#E2E8F0" Margin="0,0,0,8"/>
                            <TextBlock Text="LF/RF: front left/right · LR/RR: rear left/right. CUSTOM uses four independent values."
                                       Foreground="#94A3B8" TextWrapping="Wrap" FontSize="11"/>
                            <ComboBox ItemsSource="{Binding MotorTargets}" SelectedItem="{Binding SelectedMotor}"/>
                            <TextBlock Text="Common PWM % (selected motor / ALL)" TextWrapping="Wrap"/>
                            <TextBox x:Name="MotorCommonInput" Text="{Binding MotorPercent, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}" Padding="5"/>
                            <Slider Minimum="0" Maximum="100" TickFrequency="0.1" IsSnapToTickEnabled="True"
                                    Value="{Binding MotorPercent}" Margin="0,6,0,8"/>
                            <Button Content="Copy common PWM to all four" Command="{Binding CopyMotorPwmCommand}"/>
                            <TextBlock Text="CUSTOM — independent PWM %" FontWeight="SemiBold" Margin="0,3,0,7"/>
                            <DockPanel><TextBlock Text="LF  " VerticalAlignment="Center"/><TextBox x:Name="MotorLFInput" Text="{Binding MotorLF, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}" Padding="5"/></DockPanel>
                            <Slider Minimum="0" Maximum="100" TickFrequency="0.1" IsSnapToTickEnabled="True" Value="{Binding MotorLF}" Margin="0,4,0,8"/>
                            <DockPanel><TextBlock Text="RF  " VerticalAlignment="Center"/><TextBox x:Name="MotorRFInput" Text="{Binding MotorRF, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}" Padding="5"/></DockPanel>
                            <Slider Minimum="0" Maximum="100" TickFrequency="0.1" IsSnapToTickEnabled="True" Value="{Binding MotorRF}" Margin="0,4,0,8"/>
                            <DockPanel><TextBlock Text="LR  " VerticalAlignment="Center"/><TextBox x:Name="MotorLRInput" Text="{Binding MotorLR, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}" Padding="5"/></DockPanel>
                            <Slider Minimum="0" Maximum="100" TickFrequency="0.1" IsSnapToTickEnabled="True" Value="{Binding MotorLR}" Margin="0,4,0,8"/>
                            <DockPanel><TextBlock Text="RR  " VerticalAlignment="Center"/><TextBox x:Name="MotorRRInput" Text="{Binding MotorRR, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}" Padding="5"/></DockPanel>
                            <Slider Minimum="0" Maximum="100" TickFrequency="0.1" IsSnapToTickEnabled="True" Value="{Binding MotorRR}" Margin="0,4,0,8"/>
                            <TextBlock Text="Duration (ms, e.g. 60000 = 1 minute)" TextWrapping="Wrap"/>
                            <TextBox Text="{Binding MotorDuration, UpdateSourceTrigger=PropertyChanged}" Padding="6" Margin="0,5,0,10"/>
                            <CheckBox Content="Continuous until STOP" IsChecked="{Binding ContinuousMotors}" Foreground="#E2E8F0" Margin="0,0,0,8"/>
                            <TextBlock Text="{Binding MotorPreview}" Foreground="#94A3B8" TextWrapping="Wrap" Margin="0,0,0,8"/>
                            <TextBlock Text="Edits apply only when you click Run / apply; this restarts the duration. Link loss stops outputs after about 2 seconds."
                                       Foreground="#94A3B8" TextWrapping="Wrap" FontSize="11" Margin="0,0,0,8"/>
                            <WrapPanel>
                                <Button Content="Run / apply" Command="{Binding RunMotorCommand}">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding ElementName=MotorCommonInput, Path=(Validation.HasError)}" Value="True"><Setter Property="IsEnabled" Value="False"/></DataTrigger>
                                                <DataTrigger Binding="{Binding ElementName=MotorLFInput, Path=(Validation.HasError)}" Value="True"><Setter Property="IsEnabled" Value="False"/></DataTrigger>
                                                <DataTrigger Binding="{Binding ElementName=MotorRFInput, Path=(Validation.HasError)}" Value="True"><Setter Property="IsEnabled" Value="False"/></DataTrigger>
                                                <DataTrigger Binding="{Binding ElementName=MotorLRInput, Path=(Validation.HasError)}" Value="True"><Setter Property="IsEnabled" Value="False"/></DataTrigger>
                                                <DataTrigger Binding="{Binding ElementName=MotorRRInput, Path=(Validation.HasError)}" Value="True"><Setter Property="IsEnabled" Value="False"/></DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                                <Button Content="STOP ALL" Command="{Binding StopMotorsCommand}" Background="#991B1B"/>
                            </WrapPanel>
                            <TextBlock Text="{Binding MotorStatus}" TextWrapping="Wrap" Foreground="#67E8F9"/>
                        </StackPanel>
                    </Border>
                    <TextBlock Text="BALANCE ON TEST RIG" FontWeight="Bold" Margin="0,16,0,8"/>
                    <TextBlock Text="Rate PID: Kp 0–5, Ki 0–2, Kd 0–0.2. Use decimal point. Gains apply only while stopped. Default gains are zero; tune on rig." TextWrapping="Wrap" Foreground="#94A3B8"/>
                    <StackPanel IsEnabled="{Binding ControlEditable}" Margin="0,8,0,0">
                        <StackPanel IsEnabled="{Binding CascadeEditable}">
                            <TextBlock Text="Outer angle PID → target rate (±45 °/s). Default 2 / 0 / 0; requires cascade firmware." TextWrapping="Wrap"/>
                            <TextBlock Text="Angle Roll Kp / Ki / Kd"/>
                            <UniformGrid Columns="3">
                                <TextBox Text="{Binding AngleRollKp, UpdateSourceTrigger=PropertyChanged}" Padding="4"/>
                                <TextBox Text="{Binding AngleRollKi, UpdateSourceTrigger=PropertyChanged}" Padding="4"/>
                                <TextBox Text="{Binding AngleRollKd, UpdateSourceTrigger=PropertyChanged}" Padding="4"/>
                            </UniformGrid>
                            <TextBlock Text="Angle Pitch Kp / Ki / Kd"/>
                            <UniformGrid Columns="3">
                                <TextBox Text="{Binding AnglePitchKp, UpdateSourceTrigger=PropertyChanged}" Padding="4"/>
                                <TextBox Text="{Binding AnglePitchKi, UpdateSourceTrigger=PropertyChanged}" Padding="4"/>
                                <TextBox Text="{Binding AnglePitchKd, UpdateSourceTrigger=PropertyChanged}" Padding="4"/>
                            </UniformGrid>
                        </StackPanel>
                        <TextBlock Text="Inner rate Roll Kp / Ki / Kd" Margin="0,8,0,0"/>
                        <UniformGrid Columns="3">
                            <TextBox Text="{Binding RollKp, UpdateSourceTrigger=PropertyChanged}" Padding="4"/>
                            <TextBox Text="{Binding RollKi, UpdateSourceTrigger=PropertyChanged}" Padding="4"/>
                            <TextBox Text="{Binding RollKd, UpdateSourceTrigger=PropertyChanged}" Padding="4"/>
                        </UniformGrid>
                        <TextBlock Text="Inner rate Pitch Kp / Ki / Kd" Margin="0,6,0,0"/>
                        <UniformGrid Columns="3">
                            <TextBox Text="{Binding PitchKp, UpdateSourceTrigger=PropertyChanged}" Padding="4"/>
                            <TextBox Text="{Binding PitchKi, UpdateSourceTrigger=PropertyChanged}" Padding="4"/>
                            <TextBox Text="{Binding PitchKd, UpdateSourceTrigger=PropertyChanged}" Padding="4"/>
                        </UniformGrid>
                        <Button Content="Apply PID" Command="{Binding ApplyPidCommand}"/>
                        <TextBlock Text="Base duty (1–180 of 255)"/>
                        <TextBox Text="{Binding BaseDuty, UpdateSourceTrigger=PropertyChanged}" Padding="4"/>
                        <TextBlock Text="Roll / pitch target ° (−10 to +10)"/>
                        <UniformGrid Columns="2">
                            <TextBox Text="{Binding RollTarget, UpdateSourceTrigger=PropertyChanged}" Padding="4"/>
                            <TextBox Text="{Binding PitchTarget, UpdateSourceTrigger=PropertyChanged}" Padding="4"/>
                        </UniformGrid>
                        <ComboBox ItemsSource="{Binding ControlAxes}" SelectedItem="{Binding ControlAxis}"/>
                        <Button Content="Set firmware level reference" Command="{Binding ZeroControlCommand}"/>
                    </StackPanel>
                    <TextBlock Text="{Binding AppliedPid}" TextWrapping="Wrap" Margin="0,8,0,4"/>
                    <CheckBox IsChecked="{Binding RigConfirmed}" Foreground="#E2E8F0">
                        <TextBlock Text="Rig secured; motor mapping and correction direction verified" TextWrapping="Wrap"/>
                    </CheckBox>
                    <WrapPanel>
                        <Button Content="Arm balance" Command="{Binding ArmControlCommand}"/>
                        <Button Content="Start balance" Command="{Binding StartControlCommand}"/>
                        <Button Content="STOP / DISARM" Command="{Binding StopMotorsCommand}" Background="#991B1B"/>
                    </WrapPanel>
                    <TextBlock Text="{Binding ControlStatus}" TextWrapping="Wrap" Foreground="#67E8F9"/>
                    <TextBlock Text="{Binding ControlData}" TextWrapping="Wrap" FontSize="11" Margin="0,6,0,6"/>
                    <Button Content="Start / stop CSV log" Command="{Binding ToggleControlLogCommand}"/>
                    <TextBlock Text="{Binding LogStatus}" TextWrapping="Wrap" FontSize="11"/>
                    <TextBlock Text="PERFORMANCE" FontSize="11" Foreground="#94A3B8" Margin="0,5,0,7"/>
                    <TextBlock Text="{Binding SampleRate, StringFormat=Data: {0:F0} samples/s}"/>
                    <TextBlock Text="{Binding FramesPerSecond, StringFormat=Viewport: {0:F0} FPS}" Margin="0,3,0,0"/>

                    <TextBlock Margin="0,20,0,0" Foreground="#64748B" TextWrapping="Wrap"
                               Text="Yaw is relative and may drift; this viewer uses accelerometer and gyro data."/>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <Border Grid.Column="2" Background="#0F172A" CornerRadius="12" ClipToBounds="True">
            <TabControl SelectedIndex="1" Background="#0F172A" BorderThickness="0">
            <TabItem Header="3D orientation" Foreground="#111827">
            <Grid>
            <h:HelixViewport3D Background="#0F172A"
                               ShowViewCube="True"
                               ShowCoordinateSystem="False"
                               ZoomExtentsWhenLoaded="False"
                               IsHeadLightEnabled="False">
                <h:HelixViewport3D.Camera>
                    <PerspectiveCamera Position="0,5,10" LookDirection="0,-5,-10" UpDirection="0,1,0" FieldOfView="42"/>
                </h:HelixViewport3D.Camera>
                <h:SunLight/>
                <h:GridLinesVisual3D Width="12" Length="12" MinorDistance="0.5" MajorDistance="2"
                                     Thickness="0.012" Fill="#334155">
                    <h:GridLinesVisual3D.Transform>
                        <Transform3DGroup>
                            <RotateTransform3D>
                                <RotateTransform3D.Rotation>
                                    <AxisAngleRotation3D Axis="1,0,0" Angle="-90"/>
                                </RotateTransform3D.Rotation>
                            </RotateTransform3D>
                            <TranslateTransform3D OffsetY="-1.2"/>
                        </Transform3DGroup>
                    </h:GridLinesVisual3D.Transform>
                </h:GridLinesVisual3D>
                <h:CoordinateSystemVisual3D ArrowLengths="1.2"/>

                <ModelVisual3D x:Name="DroneModel">
                    <ModelVisual3D.Transform>
                        <RotateTransform3D>
                            <RotateTransform3D.Rotation>
                                <QuaternionRotation3D Quaternion="{Binding DisplayQuaternion}"/>
                            </RotateTransform3D.Rotation>
                        </RotateTransform3D>
                    </ModelVisual3D.Transform>
                </ModelVisual3D>
            </h:HelixViewport3D>
                <TextBlock x:Name="ModelLoadStatus" Text="Loading drone model..."
                           HorizontalAlignment="Center" VerticalAlignment="Bottom"
                           Margin="20" Foreground="#E2E8F0" TextWrapping="Wrap" IsHitTestVisible="False"/>
            </Grid>
            </TabItem>
            <TabItem Header="Live PID plots" Foreground="#111827">
                <Grid Background="#0F172A">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <WrapPanel Margin="10" VerticalAlignment="Center">
                        <TextBlock Text="Plot axis" Foreground="#E2E8F0" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <ComboBox ItemsSource="{Binding PlotAxes}" SelectedItem="{Binding PlotAxis}" Width="100" Margin="0,0,12,0"/>
                        <CheckBox Content="Pause plots" IsChecked="{Binding PausePlots}" Foreground="#E2E8F0" VerticalAlignment="Center" Margin="0,0,12,0"/>
                        <Button Content="Clear plots" Command="{Binding ClearPlotsCommand}" Margin="0"/>
                        <TextBlock Text="20 Hz telemetry · 200 Hz controller" Foreground="#94A3B8" VerticalAlignment="Center" Margin="12,0,0,0"/>
                    </WrapPanel>
                    <controls:PidPlot Grid.Row="1" History="{Binding PidHistory}" Axis="{Binding PlotAxis}"/>
                </Grid>
            </TabItem>
            </TabControl>
        </Border>
    </Grid>
</Window>
